msgstr "Import"

#: gdms/gui/__init__.py:348
msgid "Settings were successfully imported from file"
msgstr "Beállítások sikeresen importálva fájlból"

#: gdms/gui/__init__.py:350
msgid "Failed to import. File is invalid"
msgstr "Sikertelen import. A fájl érvénytelen"

#: gdms/gui/__init__.py:381
msgid "Settings were successfully exported"
msgstr "Beállítások sikeres exportja"

#: gdms/gui/__init__.py:383
