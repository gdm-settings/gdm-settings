#: gdms/gui/pages/display.py:108
msgid "OK"
msgstr "Rendben"

#: gdms/gui/__init__.py:223
msgid "Default Shell Theme File Lost"
msgstr "Az alapértelmezett Shell téma fájl elveszett"

#: gdms/gui/__init__.py:225
msgid ""
"The app needs but could not find an unmodified default shell theme file. To "
"fix the issue, reinstall 'gnome-shell-common' or 'gnome-shell' package."
msgstr ""
"Az alkalmazásnak szüksége van egy módosítatlan alapértelmezett shell "
"témafájlra, de nem találja azt. A probléma megoldásához telepítse újra a „"
"gnome-shell-common” vagy a „gnome-shell” csomagot."

#: gdms/gui/__init__.py:236
msgid "Donation Request"
msgstr "Adománykérés"

#: gdms/gui/__init__.py:238
msgid ""
"If you like this app, please consider donating so that we can keep improving "
"it.\n"
"Thank you! ❤️️"
msgstr ""
"Ha tetszik ez az alkalmazás, kérjük, fontoljon a továbbfejlesztési lehetőség "
"véget egy adományt.\n"
"Köszönjük! ❤️️"

#: gdms/gui/__init__.py:244
msgid "Not Interested"
msgstr "Nem érdekel"

#: gdms/gui/__init__.py:245 resources/ui/main-window.blp:15
msgid "Donate"
msgstr "Adományozon"

